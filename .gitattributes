# Recorded harness logs must stay byte-exact (no CRLF conversion on checkout)
tests/fixtures/harness/** -text
# Bash refuses CRLF: the base image's cg-al shim stays LF on every checkout
harness/images/base/cg-al text eol=lf
# Hashed by the egress marker (recorded_hosts_sha256): never convert line endings.
harness/egress/recorded-hosts.json -text
# Hashed by al-lsp.json (probe block) and checked at image build: LF on every checkout (M10-04)
harness/images/claude-code/lsp/*.mjs text eol=lf
harness/images/claude-code/lsp/al-lsp.json text eol=lf
