# pi harness image. Built by `harness images build pi --version 0.87.1 --revision 2`.
# BASE has no default: `harness images build` passes the inspected immutable base image and
# verifies the layers (M1-24). Node 22.19.0 comes from the base (pi 0.87.1 engines, findings section 3).
# No secret is ever copied into a layer: the provider key arrives as a file at run time.
ARG BASE
FROM ${BASE}
# A machine-wide npm prefix (H-01): ContainerUser can read and run it; the default
# prefix sits in ContainerAdministrator's profile.
RUN $env:PATH = 'C:\Program Files\nodejs;' + $env:PATH; \
    npm install -g --prefix C:\cg-npm @earendil-works/pi-coding-agent@0.87.1; \
    [Environment]::SetEnvironmentVariable('PATH', 'C:\cg-npm;' + [Environment]::GetEnvironmentVariable('PATH', 'Machine'), [EnvironmentVariableTarget]::Machine)
# pi's agent directory (H-01 run 005), by SID, inheritance off. The harness
# stages settings.json, AGENTS.md and auth.json there as admin (cg-pi-stage.ps1);
# pi locks settings.json by making a settings.json.lock directory beside it, so
# Users may add subdirectories (AD, this folder only; CREATOR OWNER makes each
# its creator's) but never create, replace or delete a file.
RUN New-Item -ItemType Directory -Force -Path C:\pi-agent | Out-Null; \
    icacls C:\pi-agent /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' '*S-1-5-32-545:(OI)(CI)RX' '*S-1-3-0:(OI)(CI)(IO)F' /Q; \
    if ($LASTEXITCODE -ne 0) { throw ('icacls C:\pi-agent failed: ' + $LASTEXITCODE) }; \
    icacls C:\pi-agent /grant '*S-1-5-32-545:(AD)' /Q; \
    if ($LASTEXITCODE -ne 0) { throw ('icacls C:\pi-agent failed: ' + $LASTEXITCODE) }
COPY run.ps1 C:/run.ps1
COPY cg-budget.ts C:/cg-budget.ts
COPY cg-pi-stage.ps1 C:/cg-pi-stage.ps1
# H-01 run 004: what this image adds is read-only for the agent user (C:\pi-agent
# carries its own ACL above).
RUN powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:\cg-lockdown.ps1 C:\cg-npm C:\run.ps1 C:\cg-budget.ts C:\cg-pi-stage.ps1; \
    if ($LASTEXITCODE -ne 0) { throw ('cg-lockdown failed: ' + $LASTEXITCODE) }
# H-01: defense in depth; the harness also passes --user ContainerUser.
USER ContainerUser
CMD ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:\\run.ps1"]
