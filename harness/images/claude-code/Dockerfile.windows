# Claude Code harness image. Built by `harness images build claude-code --revision 3` (proofs: --revision 3-dev-<task id>).
# H-03: the build resolves the newest @anthropic-ai/claude-code (npm dist-tag latest); no version is hand-pinned here.
# BASE has no default: `harness images build` passes the inspected immutable base image and then
# verifies that the built image's layers start with the base's layers (M1-24).
ARG BASE
FROM ${BASE}
# H-03: the release `harness images build` resolved from the npm registry (version, both tarball URLs,
# both sha512 integrities). No defaults: install-claude-code.ps1 refuses absent or malformed values,
# installs only the two verified archives (npm offline without scripts, else tar.exe on the same
# files) into the machine-wide prefix C:\cg-npm (H-01: ContainerUser can read and run it), and
# claude.exe is on the Machine PATH directly (no npm shim).
ARG CLAUDE_CODE_VERSION
ARG CLAUDE_CODE_URL
ARG CLAUDE_CODE_INTEGRITY
ARG CLAUDE_CODE_WIN_URL
ARG CLAUDE_CODE_WIN_INTEGRITY
# Build time only, removed after a checked success. It sits under the locked C:\cg-lsp like
# install-lsp.ps1 (H-01 run 004: every COPY lands in a locked path); never under C:\cg-npm,
# which install-claude-code.ps1 requires to hold only node_modules.
COPY install-claude-code.ps1 C:/cg-lsp/install-claude-code.ps1
RUN $env:PATH = 'C:\Program Files\nodejs;' + $env:PATH; \
    powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:\cg-lsp\install-claude-code.ps1 -Version $env:CLAUDE_CODE_VERSION -MainUrl $env:CLAUDE_CODE_URL -MainIntegrity $env:CLAUDE_CODE_INTEGRITY -WinUrl $env:CLAUDE_CODE_WIN_URL -WinIntegrity $env:CLAUDE_CODE_WIN_INTEGRITY; \
    if ($LASTEXITCODE -ne 0) { throw ('install-claude-code failed: ' + $LASTEXITCODE) }; \
    Remove-Item -Force C:\cg-lsp\install-claude-code.ps1; \
    [Environment]::SetEnvironmentVariable('PATH', 'C:\cg-npm\node_modules\@anthropic-ai\claude-code\bin;' + [Environment]::GetEnvironmentVariable('PATH', 'Machine'), [EnvironmentVariableTarget]::Machine)
# M10: the AL language server plugin (al-lsp-for-agents wrapper, Microsoft AL extension, private
# .NET 10), recipe in lsp/al-lsp.json. Every arm's image has it; only an arm that declares
# components.lsp loads it. The probe is two files that must sit side by side.
COPY lsp/al-lsp.json C:/cg-lsp/al-lsp.json
COPY lsp/lsp-probe.mjs C:/cg-lsp/lsp-probe.mjs
COPY lsp/lsp-probe-lib.mjs C:/cg-lsp/lsp-probe-lib.mjs
COPY lsp/install-lsp.ps1 C:/cg-lsp/install-lsp.ps1
# M10-10: the al-lsp-for-agents release `harness images build` resolved from the GitHub API
# (tag, asset URL, asset digest). No defaults: install-lsp.ps1 refuses absent or malformed values.
ARG LSP_RELEASE
ARG LSP_WRAPPER_URL
ARG LSP_WRAPPER_SHA256
RUN powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:\cg-lsp\install-lsp.ps1 -Release $env:LSP_RELEASE -Url $env:LSP_WRAPPER_URL -Sha256 $env:LSP_WRAPPER_SHA256; \
    if ($LASTEXITCODE -ne 0) { throw ('install-lsp failed: ' + $LASTEXITCODE) }; \
    Remove-Item -Force C:\cg-lsp\install-lsp.ps1
COPY run.ps1 C:/run.ps1
COPY cg-inventory.ps1 C:/cg-inventory.ps1
# H-01 run 004: what this image adds is read-only for the agent user.
RUN powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:\cg-lockdown.ps1 C:\cg-npm C:\run.ps1 C:\cg-inventory.ps1 C:\cg-lsp; \
    if ($LASTEXITCODE -ne 0) { throw ('cg-lockdown failed: ' + $LASTEXITCODE) }
# H-01: defense in depth; the harness also passes --user ContainerUser.
USER ContainerUser
CMD ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:\\run.ps1"]
